<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.ysh.tools</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Android code tools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Yang-Shuang/android-code-tools">android-code-tools</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Android 应用开发者便捷工具
        1.使用快捷键跳转到对应的xml页面或者activity、fragment文件<br>
        匹配规则1 setContentView(R.layout. <br>
        匹配规则2 .inflate(R.layout. <br>
        匹配规则3 名称模糊比配，如：frangment_test_show <-->  TestShowFragment,ShowTestFragment,TestShow.....Fragment等<br>
        匹配规则4 规范Name解析，如：MainActivity <--> activity_main<br>
         <br>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.compose</depends>

    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- id 必须与你 Java 代码中的 GROUP_ID 常量值一模一样 -->
        <!-- displayType 可选：BALLOON (常规气泡/Toast), STICKY_BALLOON (常驻气泡), NONE (只留日志) -->
        <notificationGroup id="AndroidCodeTools"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
    </extensions>
    <actions>
        <action id="Tools.ActivityOpenXml" class="com.ysh.tools.openXml.ActivityOpenXmlAction" text="打开Activity/Xml"
                description="activity,xml open">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt I"/>
        </action>
        <action id="CreateActivityFileAction"
                class="com.ysh.tools.generate.CreateActivityAction"
                text="Create Activity File..."
                description="Create Activity and parse layout XML">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <action id="CreateFragmentFileAction"
                class="com.ysh.tools.generate.CreateFragmentAction"
                text="Create Fragment File..."
                description="Create Fragment and parse layout XML">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="CreateActivityFileAction"/>
        </action>
        <action id="CreateDialogFileAction"
                class="com.ysh.tools.generate.CreateDialogAction"
                text="Create Dialog File..."
                description="Create Dialog and parse layout XML">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="CreateFragmentFileAction"/>
        </action>
        <action id="CreateAdapterFileAction"
                class="com.ysh.tools.generate.CreateAdapterAction"
                text="Create Adapter File..."
                description="Create Adapter with bean">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="CreateDialogFileAction"/>
        </action>
        <action id="CreateHolderFileAction"
                class="com.ysh.tools.generate.CreateHolderAction"
                text="Create Holder File..."
                description="Create Holder with layout XML">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="CreateAdapterFileAction"/>
        </action>
        <action id="CreateHolderClassAction"
                class="com.ysh.tools.generate.CreateHolderClassAction"
                text="Create Holder Class..."
                description="Create Holder with layout XML">
            <!-- 挂载到右键菜单的 New 列表组中 -->
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Tools.ActivityOpenXml"/>
        </action>
        <action id="FindViewsGenerateAction"
                class="com.ysh.tools.generate.FindViewsGenerateAction"
                text="findViews"
                description="Generate findViewById code for Activity/Fragment/Dialog/Holder">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="ClickViewsGenerateAction"
                class="com.ysh.tools.generate.ClickViewsGenerateAction"
                text="clickViews"
                description="Generate onClick view branching code for Activity/Fragment/Dialog/Holder">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="RequestCodeGenerateAction"
                class="com.ysh.tools.generate.RequestCodeGenerateAction"
                text="requestCode"
                description="Generate network request code">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>

        <action id="ResponseCodeGenerateAction"
                class="com.ysh.tools.generate.ResponseCodeGenerateAction"
                text="responseCode"
                description="Generate network response code">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <group id="ShowDefaultCodeTemplateGroup"
               class="com.ysh.tools.generate.ShowDefaultTemplatesGroup"
               text="Show default code template"
               description="View built-in default code templates for reference"
               popup="true">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>